PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Multiple browser origins may be comma-separated. CLIENT_URL takes precedence.
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
SESSION_SECRET=change_me_to_a_long_random_string

# Google OAuth (optional locally; required to enable Google sign-in)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Password reset delivery (optional; endpoint stays generic when unset)
# PASSWORD_RESET_WEBHOOK_URL=https://your-mail-service.example/reset

# Groq (free tier) — powers the LangChain agent, insights, and receipt vision.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=qwen/qwen3-32b
GROQ_VISION_MODEL=

# Comma-separated admin emails (they see the /admin observability page)
ADMIN_EMAILS=

# SQLite location (defaults to server/data; set to a mounted volume in production)
# DATA_DIR=/app/server/data

# NVIDIA NIM (optional) — receipt vision. Free trial credits at build.nvidia.com.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
