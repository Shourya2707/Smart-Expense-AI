PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_me_to_a_long_random_string

# Groq (free tier) — powers the LangChain agent, insights, and receipt vision.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=

# Comma-separated admin emails (they see the /admin observability page)
ADMIN_EMAILS=

# SQLite location (defaults to server/data; set to a mounted volume in production)
# DATA_DIR=/app/server/data

# NVIDIA NIM (optional) — receipt vision. Free trial credits at build.nvidia.com.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
