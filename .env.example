PORT=5001
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
GROQ_API_KEY=replace-with-your-groq-key
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Render persistent disk mount path. Without a persistent disk, SQLite resets on redeploy.
DATA_DIR=/app/server/data
# Optional when frontend and API use different domains.
CLIENT_URL=http://localhost:5173
# Optional webhook/email provider endpoint for password reset delivery.
# PASSWORD_RESET_WEBHOOK_URL=
